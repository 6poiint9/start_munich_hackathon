# Kopieren nach .env und Werte eintragen. Diese Datei enthält keine Secrets.
LLM_PROVIDER=grok
LLM_FALLBACK=none
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
LLM_MODEL_FAST=grok-4.20-0309-non-reasoning
LLM_MODEL_REASONING=grok-4.7
LLM_MAX_PARALLEL=8
GMAIL_ADDRESS=tripletstarthack@gmail.com
GMAIL_APP_PASSWORD=
MAIL_MODE=DRY_RUN
PORTAL_BASE=https://start-hack-portal-cxh3crbdaef2f8gt.westeurope-01.azurewebsites.net
PORTAL_TOKEN=

# Kern (docs/umsetzung.md, architecture.md §8). MAIL_MODE: DRY_RUN | LIVE | REPLAY
LINEGUARD_PACK=packs/soony_gh6
READER_CONCURRENCY=8
LEASE_SECONDS=300
STATE_TOP_N=50
# Optional. Standard: sqlite:///data/<workspace>/lineguard.sqlite
# DATABASE_URL=
# Optional. Stellt die Uhr für Demo und Tests (architecture.md §10)
# LINEGUARD_NOW=2026-11-21T13:00:00+01:00
